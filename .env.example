# 复制成 .env 再填。.env 已经在 .gitignore 里，不会被提交。
#   cp .env.example .env
#   node scripts/live-check.mjs
#
# 脚本只做两件事：拉一次模型列表、跑一次真实的写词请求（会挂 search_tags 工具）。
# 输出里的 Key 一律打码。

# ── 主模型 ──
# 协议三选一：openai-chat / responses / anthropic-messages
NAI_PROTOCOL=openai-chat

# DeepSeek 的两套接口：
#   OpenAI 兼容    https://api.deepseek.com/chat/completions   （配 openai-chat）
#   Anthropic 兼容 https://api.deepseek.com/anthropic/v1/messages（配 anthropic-messages）
NAI_ENDPOINT=https://api.deepseek.com/chat/completions

NAI_MODEL=deepseek-v4-flash-vision-exp
NAI_API_KEY=

# 可选：思考档位 off / low / medium / high。
# 想复现「思考 token 把额度吃光」时调高。
NAI_REASONING_EFFORT=off

# 可选：服务商 id，只影响日志里显示的名字和少数几家的特殊分支
NAI_PROVIDER_ID=deepseek
